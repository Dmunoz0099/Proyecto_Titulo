{
  "name": "cuidamayor-vercel",
  "version": "1.0.0",
  "description": "Manifiesto de despliegue en Vercel: junta el frontend (client) y el backend (server) en un solo proyecto. Para desarrollo local sigue usando client/ y server/ por separado.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:server": "pnpm -C server dev",
    "dev:client": "pnpm -C client dev",
    "build": "pnpm -C client build",
    "seed": "pnpm -C server seed",
    "vercel-build": "prisma generate --schema=server/prisma/schema.prisma && pnpm -C client build"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
